#
# Tests whether "maintenance print remote-registers" command correctly shows
# expedited registers on Intel GT devices.  Verifies that r0, ce, sr0,
# cr0, genstbase, and isabase registers are always expedited.  For GRF size
# 128 (kernel-1), r127 should be expedited.  For GRF size 256 (kernel-2),
# r255 should be expedited.

load_lib sycl.exp

standard_testfile intelgt-multi-kernel-grfsize.cpp

# Helper procedure to check expedited registers.
proc check_expedited_registers { expected_regs kernel_desc } {
    # Initialize found flags for all registers.
    array unset found_regs
    foreach reg_info $expected_regs {
	set reg_name [lindex $reg_info 0]
	set found_regs($reg_name) 0
    }

    # Use gdb_test_multiple to process output line by line.
    set unexpected_expedited_regs {}
    gdb_test_multiple "maintenance print remote-registers" \
	"maintenance print remote-registers shows expedited registers for $kernel_desc" {
	-re "\r\n(\[a-zA-Z0-9_\]+)\[^\r\n\]*yes\[^\r\n\]*" {
	    set reg_name $expect_out(1,string)
	    if {[info exists found_regs($reg_name)]} {
		set found_regs($reg_name) 1
	    } else {
		lappend unexpected_expedited_regs $reg_name
	    }
	    exp_continue
	}
	-re "\r\n(\[a-zA-Z0-9_\]+)\[^\r\n\]*" {
	    # This matches non-expedited registers (register lines with numbers)
	    exp_continue
	}
	-re -wrap "" {
	}
    }

    # Check results and report pass/fail for each register.
    foreach reg_info $expected_regs {
	set reg_name [lindex $reg_info 0]
	set reg_desc [lindex $reg_info 1]
	gdb_assert {$found_regs($reg_name)} "$reg_desc register is expedited in $kernel_desc"
    }

    # Report unexpected expedited registers.
    foreach reg_name $unexpected_expedited_regs {
	fail "Unexpected expedited register $reg_name in $kernel_desc"
    }
}

set sycl_device_list [init_sycl_devices_list]
if {[llength $sycl_device_list] == 0} {
    unsupported "target does not support SYCL"
    return 0
}

if {[build_executable "failed to compile $srcfile" \
    "${binfile}" $srcfile {sycl debug}]} {
    return -1
}

foreach device $sycl_device_list {

    sycl_with_intelgt_lock $device {

	if {![require_sycl_device "$device" "gpu" "Intel*"]} {
	    unsupported "test is aimed at Intel GPUs only"
	    continue
	}

	# Limit test to specific platforms where expedited registers are stable.
	# Expedited registers may change across platforms and even within the same
	# platform, so we only test on HPG, HPC, XE2, and XE3.
	if {![is_xe_hpg $device] && ![is_xe_hpc $device] && ![is_xe2 $device] && ![is_xe3 $device]} {
	    unsupported "expedited registers test limited to HPG, HPC, XE2, and XE3 platforms"
	    continue
	}

	clean_restart "${binfile}"

	if {![sycl_start $device]} {
	    continue
	}

	# Set temporary breakpoints in the kernels and run to them.
	set kernel1_line [gdb_get_line_number "kernel-1-line"]
	set kernel2_line [gdb_get_line_number "kernel-2-line"]

	gdb_breakpoint $kernel1_line "temporary"
	gdb_breakpoint $kernel2_line "temporary"

	gdb_continue_to_breakpoint "kernel-1-line" ".*kernel-1-line.*"

	# Define expected expedited registers for kernel-1 (GRF 128).
	set kernel1_expedited_regs {
	    {"r0" "first general register aka r0"}
	    {"r127" "last general register for GRF 128 is r127"}
	    {"ce" "channel enable register aka ce"}
	    {"sr0" "state register 0 aka sr0"}
	    {"cr0" "control register 0 aka cr0"}
	    {"genstbase" "general state base register aka genstbase"}
	    {"isabase" "instruction state base register aka isabase"}
	}

	# Test expedited registers for first kernel.
	check_expedited_registers $kernel1_expedited_regs "kernel-1 for GRF 128"

	# Continue to the second kernel.
	gdb_continue_to_breakpoint "kernel-2-line" ".*kernel-2-line.*"

	# Define expected expedited registers for kernel-2 (GRF 256).
	set kernel2_expedited_regs $kernel1_expedited_regs
	lset kernel2_expedited_regs 1 {"r255" "last general register for GRF 256 is r255"}

	# Test expedited registers for second kernel.
	check_expedited_registers $kernel2_expedited_regs "kernel-2 for GRF 256"
    }
}
