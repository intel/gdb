#
# Test non-stop functionality for SYCL.  Define a breakpoint that is
# hit by two threads.  Resume and then interrupt one of those threads.

load_lib sycl.exp

standard_testfile parallel-for-branch.cpp

set sycl_device_list [init_sycl_devices_list]
if {[llength $sycl_device_list] == 0} {
    unsupported "target does not support SYCL"
    return 0
}

if {[build_executable "failed to compile $srcfile" \
    "${binfile}" $srcfile {sycl debug}]} {
    return -1
}

# If the input inferior INF is not empty then it returns the ID of the first
# running thread of an inferior INF.  In this case, the returned thread ID is
# in the format of (<inferior number>.<thread number>) and SIMD lane
# information is omitted.  If INF is empty, then it return the <thread number>
# only of any running thread.  Returns "none" if no thread ID is found with
# given parameters.

proc get_one_running_thread {inf} {
    set running_thread "none"

    gdb_test_multiple "info threads" "get running thread" -lbl {
	-re " +($inf\(\.$::decimal\)?) +\[^\r\n\]+\(running\)" {
	    if {$running_thread eq "none"} {
		set running_thread $expect_out(1,string)
	    }
	    exp_continue
	}
	-re -wrap "" {
	    gdb_assert {$running_thread ne "none"} $gdb_test_name
	}
    }

    return $running_thread
}

foreach device $sycl_device_list {
    clean_restart "${binfile}"
    sycl_with_intelgt_lock $device {

	set fill "\[^\r\n\]*"

	gdb_test_no_output "set non-stop on"
	if {![runto_main [sycl_get_device_args $device]]} {
	    continue
	}

	# Set the breakpoint.
	set bp [gdb_get_line_number "kernel-last-line"]
	gdb_breakpoint "$bp if dim0 == 9 || dim0 == 117"

	# Two threads are expected to hit.
	set fill "\[^\r\n\]*"
	set stopped_threads ""
	set tid_re "$decimal\(\.$decimal\)?"
	gdb_test_multiple "continue -a" "continue to the breakpoint" {
	    -re "Thread ($tid_re)$fill hit Breakpoint $fill$srcfile:$bp\r\n" {
		set thread_id $expect_out(1,string)
		lappend stopped_threads $thread_id
		if {[llength $stopped_threads] == 2} {
		    pass $gdb_test_name
		} else {
		    exp_continue
		}
	    }
	    -re "$gdb_prompt " {
		exp_continue
	    }
	}

	verbose -log "Stopped threads: $stopped_threads"
	if {[llength $stopped_threads] != 2} {
	    continue
	}

	# Switch to a stopped thread, resume it.
	set thread1 [lindex $stopped_threads 0]
	gdb_test "thread $thread1" \
	    ".Switching to thread ${thread1}.*" \
	    "switch to a stopped thread"

	gdb_test "continue &" "Continuing\." "resume the thread"

	# Wait to make sure the resumed thread has sufficient time
	# to terminate.
	sleep 2

	gdb_test "info threads $stopped_threads" ".*" \
	    "first info threads for logging"

	gdb_test_multiple "interrupt" "interrupt the thread" {
	    -re "$gdb_prompt " {
		gdb_test_multiple "" $gdb_test_name {
		    -re "Thread $thread1 ${fill}stopped.*" {
			pass $gdb_test_name
		    }
		}
	    }
	}

	# Once more, for the log.
	gdb_test "info threads $stopped_threads" ".*" \
	    "second info threads for logging"

	# On the Intel GPU, a "running" thread is either a thread that was
	# never utilized by the program, or a thread that hit a BP but has
	# been resumed by GDB because the condition was false.  In the latter,
	# the thread must have already finished its kernel.  In either case,
	# the thread must be unavailable.  Trying to stop such a running thread
	# does not succeed and we should see the "could not be stopped" message.
	if {[require_sycl_device "$device" "gpu" "Intel*"]} {
	    set stop_msg "could not be stopped"
	    set inf [get_integer_valueof "\$_inferior" -1]
	    gdb_assert {$inf > 0}
	} else {
	    set stop_msg "stopped"
	    set inf ""
	}

	set running_t [get_one_running_thread $inf]
	gdb_test "thread ${running_t}" \
	    "Switching to thread.*${running_t}.*running.*" \
	    "switch to a running thread"

	gdb_test_multiple "interrupt" "interrupt the running thread" {
	    -re ".*Thread.*$running_t ${fill}${stop_msg}.*" {
		pass $gdb_test_name
	    }
	    -re -wrap "" {
		exp_continue
	    }
	}
    }
}
